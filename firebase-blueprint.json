{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated MarketOS user profile, active business pointer, subscription tier, and monthly AI usage counters.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID matching path userId" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "subscriptionTier": { "type": "string", "enum": ["STARTER", "GROWTH", "BUSINESS"] },
        "activeBusinessId": { "type": "string", "description": "Currently selected business workspace ID or empty string" },
        "aiGenerationsThisMonth": { "type": "integer", "description": "Number of AI generations in the current billing cycle" },
        "aiTokenCountThisMonth": { "type": "integer", "description": "Estimated AI tokens consumed in the current billing cycle" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId",
        "displayName",
        "email",
        "subscriptionTier",
        "activeBusinessId",
        "aiGenerationsThisMonth",
        "aiTokenCountThisMonth",
        "createdAt",
        "updatedAt"
      ]
    },
    "BusinessWorkspace": {
      "title": "BusinessWorkspace",
      "description": "International business workspace with country, location, currency, regional formatting, and brand memory.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "countryCode": { "type": "string" },
        "countryName": { "type": "string" },
        "stateRegion": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" },
        "address": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "billingCurrency": { "type": "string" },
        "displayCurrency": { "type": "string" },
        "language": { "type": "string" },
        "timeZone": { "type": "string" },
        "dateFormat": { "type": "string" },
        "numberFormat": { "type": "string" },
        "brandVoice": { "type": "string" },
        "targetAudience": { "type": "string" },
        "brandGuidelines": { "type": "string" },
        "visualDirection": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "name",
        "industry",
        "countryCode",
        "countryName",
        "stateRegion",
        "city",
        "postalCode",
        "address",
        "websiteUrl",
        "billingCurrency",
        "displayCurrency",
        "language",
        "timeZone",
        "dateFormat",
        "numberFormat",
        "brandVoice",
        "targetAudience",
        "brandGuidelines",
        "visualDirection",
        "createdAt",
        "updatedAt"
      ]
    },
    "MarketingCampaign": {
      "title": "MarketingCampaign",
      "description": "Marketing campaign belonging to a business workspace.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "PAUSED", "ARCHIVED"] },
        "platforms": { "type": "array", "description": "Target channels (max 10)" },
        "budgetAmount": { "type": "number" },
        "budgetCurrency": { "type": "string" },
        "spentAmount": { "type": "number" },
        "startDateEpoch": { "type": "integer" },
        "endDateEpoch": { "type": "integer" },
        "strategySummary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "businessId",
        "title",
        "objective",
        "status",
        "platforms",
        "budgetAmount",
        "budgetCurrency",
        "spentAmount",
        "startDateEpoch",
        "endDateEpoch",
        "strategySummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContentItem": {
      "title": "ContentItem",
      "description": "AI-generated or user-authored marketing content subject to approval and scheduling gates.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "campaignId": { "type": "string" },
        "contentType": {
          "type": "string",
          "enum": ["SOCIAL_POST", "CAPTION", "EMAIL_DRAFT", "BLOG_OUTLINE", "AD_COPY", "CREATIVE_BRIEF", "SEO_META"]
        },
        "platform": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "hashtags": { "type": "string" },
        "approvalStatus": {
          "type": "string",
          "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "REJECTED", "SCHEDULED", "PUBLISHED", "FAILED"]
        },
        "rejectionReason": { "type": "string" },
        "scheduledEpochMillis": { "type": "integer" },
        "scheduledTimeZone": { "type": "string" },
        "publishError": { "type": "string" },
        "aiModule": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "businessId",
        "campaignId",
        "contentType",
        "platform",
        "title",
        "body",
        "hashtags",
        "approvalStatus",
        "rejectionReason",
        "scheduledEpochMillis",
        "scheduledTimeZone",
        "publishError",
        "aiModule",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChannelIntegration": {
      "title": "ChannelIntegration",
      "description": "Extensible official channel integration state for a business workspace.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "provider": {
          "type": "string",
          "enum": ["INSTAGRAM", "FACEBOOK", "YOUTUBE", "EMAIL_PROVIDER", "GOOGLE_ANALYTICS", "WEBSITE_ANALYTICS"]
        },
        "status": {
          "type": "string",
          "enum": ["DISCONNECTED", "PENDING_OAUTH", "CONNECTED", "UNAVAILABLE"]
        },
        "accountLabel": { "type": "string" },
        "permissionStatus": { "type": "string" },
        "lastError": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "businessId",
        "provider",
        "status",
        "accountLabel",
        "permissionStatus",
        "lastError",
        "createdAt",
        "updatedAt"
      ]
    },
    "AiMessage": {
      "title": "AiMessage",
      "description": "Persistent conversation message in the MarketOS AI Assistant.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "ASSISTANT"] },
        "moduleUsed": { "type": "string" },
        "messageText": { "type": "string" },
        "structuredPreview": { "type": "string" },
        "attachmentLabel": { "type": "string" },
        "tokensEstimated": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "businessId",
        "role",
        "moduleUsed",
        "messageText",
        "structuredPreview",
        "attachmentLabel",
        "tokensEstimated",
        "createdAt"
      ]
    },
    "AnalyticsRecord": {
      "title": "AnalyticsRecord",
      "description": "Campaign performance and spend record explicitly flagged as actual or estimated.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "campaignId": { "type": "string" },
        "actualData": { "type": "boolean" },
        "sourceLabel": { "type": "string" },
        "periodLabel": { "type": "string" },
        "impressions": { "type": "integer" },
        "clicks": { "type": "integer" },
        "conversions": { "type": "integer" },
        "spendAmount": { "type": "number" },
        "spendCurrency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "businessId",
        "campaignId",
        "actualData",
        "sourceLabel",
        "periodLabel",
        "impressions",
        "clicks",
        "conversions",
        "spendAmount",
        "spendCurrency",
        "createdAt",
        "updatedAt"
      ]
    },
    "CytonSettings": {
      "title": "CytonSettings",
      "description": "Per-business CYTON autonomy policies, budget caps, emergency kill switch, and proactive monitoring configuration.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "autonomyMode": { "type": "string", "enum": ["SUPERVISED", "SEMI_AUTONOMOUS", "AUTONOMOUS_DRAFTS"] },
        "emergencyPaused": { "type": "boolean" },
        "dailyCreditBudget": { "type": "integer" },
        "maxTasksPerHour": { "type": "integer" },
        "voiceEnabled": { "type": "boolean" },
        "proactiveMonitoringEnabled": { "type": "boolean" },
        "monitorIntervalMinutes": { "type": "integer" },
        "allowDashboardContext": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "autonomyMode", "emergencyPaused",
        "dailyCreditBudget", "maxTasksPerHour", "voiceEnabled",
        "proactiveMonitoringEnabled", "monitorIntervalMinutes",
        "allowDashboardContext", "createdAt", "updatedAt"
      ]
    },
    "CytonAgent": {
      "title": "CytonAgent",
      "description": "Specialised CYTON agent configuration, explicit tool permissions, and operational status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "role": { "type": "string", "enum": ["ANALYST", "MARKETING", "CREATIVE", "FINANCE", "GROWTH", "OPERATIONS"] },
        "displayName": { "type": "string" },
        "status": { "type": "string", "enum": ["IDLE", "ACTIVE", "PAUSED", "ERROR"] },
        "allowedTools": { "type": "array" },
        "tasksCompleted": { "type": "integer" },
        "lastRunAtEpoch": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "role", "displayName", "status",
        "allowedTools", "tasksCompleted", "lastRunAtEpoch", "createdAt", "updatedAt"
      ]
    },
    "CytonTask": {
      "title": "CytonTask",
      "description": "Queued or executed autonomous CYTON task with idempotency, retries, credit reservations, and output.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "workflowId": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "assignedAgent": { "type": "string", "enum": ["ANALYST", "MARKETING", "CREATIVE", "FINANCE", "GROWTH", "OPERATIONS"] },
        "requestedTool": { "type": "string" },
        "title": { "type": "string" },
        "inputSummary": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"] },
        "status": { "type": "string", "enum": ["QUEUED", "RUNNING", "AWAITING_APPROVAL", "COMPLETED", "FAILED", "CANCELLED"] },
        "retryCount": { "type": "integer" },
        "maxRetries": { "type": "integer" },
        "estimatedCredits": { "type": "integer" },
        "actualCredits": { "type": "integer" },
        "requiresApproval": { "type": "boolean" },
        "resultSummary": { "type": "string" },
        "errorMessage": { "type": "string" },
        "scheduledRunAtEpoch": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "workflowId", "idempotencyKey", "assignedAgent",
        "requestedTool", "title", "inputSummary", "priority", "status",
        "retryCount", "maxRetries", "estimatedCredits", "actualCredits",
        "requiresApproval", "resultSummary", "errorMessage", "scheduledRunAtEpoch",
        "createdAt", "updatedAt"
      ]
    },
    "CytonWorkflow": {
      "title": "CytonWorkflow",
      "description": "Multi-step CYTON workflow blueprint with budget cap and autonomy tier.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "objective": { "type": "string" },
        "agentsInvolved": { "type": "array" },
        "triggerType": { "type": "string", "enum": ["MANUAL", "SCHEDULED", "METRIC_EVENT"] },
        "creditBudgetCap": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "lastRunAtEpoch": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "name", "objective", "agentsInvolved",
        "triggerType", "creditBudgetCap", "enabled", "lastRunAtEpoch",
        "createdAt", "updatedAt"
      ]
    },
    "CytonMemory": {
      "title": "CytonMemory",
      "description": "Tenant-isolated business memory storing preferences, guidelines, decisions, and feedback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "memoryType": {
          "type": "string",
          "enum": ["PREFERENCE", "BRAND_GUIDELINE", "DECISION", "APPROVED_REC", "REJECTED_REC", "WORKFLOW_SUMMARY", "PERFORMANCE_SUMMARY"]
        },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "sourceAgent": { "type": "string" },
        "retentionDays": { "type": "integer" },
        "expiresAtEpoch": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "memoryType", "title", "content",
        "sourceAgent", "retentionDays", "expiresAtEpoch", "createdAt", "updatedAt"
      ]
    },
    "CytonInsight": {
      "title": "CytonInsight",
      "description": "Proactive intelligence alert with evidence, priority, and outcome feedback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "evidenceSummary": { "type": "string" },
        "recommendedAction": { "type": "string" },
        "actualData": { "type": "boolean" },
        "usefulOutcome": { "type": "string", "enum": ["UNRATED", "HELPFUL", "NOT_HELPFUL"] },
        "dismissed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "priority", "category", "title",
        "evidenceSummary", "recommendedAction", "actualData",
        "usefulOutcome", "dismissed", "createdAt", "updatedAt"
      ]
    },
    "CytonApproval": {
      "title": "CytonApproval",
      "description": "Explicit owner approval gate before publishing, spending outside budget, deleting, or changing billing.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "taskId": { "type": "string" },
        "requestedByAgent": { "type": "string" },
        "actionType": {
          "type": "string",
          "enum": ["PUBLISH_CONTENT", "PUBLISH_AD", "SPEND_OVER_BUDGET", "DELETE_BUSINESS_DATA", "CHANGE_SUBSCRIPTION_OR_BILLING", "IRREVERSIBLE_EXTERNAL_ACTION"]
        },
        "summary": { "type": "string" },
        "targetCollection": { "type": "string" },
        "targetId": { "type": "string" },
        "estimatedSpend": { "type": "number" },
        "currencyCode": { "type": "string" },
        "decision": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED"] },
        "decisionNote": { "type": "string" },
        "decidedAtEpoch": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "taskId", "requestedByAgent", "actionType",
        "summary", "targetCollection", "targetId", "estimatedSpend", "currencyCode",
        "decision", "decisionNote", "decidedAtEpoch", "createdAt", "updatedAt"
      ]
    },
    "CytonActivityLog": {
      "title": "CytonActivityLog",
      "description": "Immutable append-only audit log of CYTON orchestrator, agent, and user actions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "actor": { "type": "string" },
        "action": { "type": "string" },
        "outcome": { "type": "string", "enum": ["SUCCESS", "BLOCKED", "FAILED", "PENDING_APPROVAL"] },
        "idempotencyKey": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "actor", "action", "outcome",
        "idempotencyKey", "details", "createdAt"
      ]
    },
    "CytonUsage": {
      "title": "CytonUsage",
      "description": "Credit reservation, actual settlement, and unused-credit refund ledger for CYTON operations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "taskId": { "type": "string" },
        "operationType": { "type": "string" },
        "creditsReserved": { "type": "integer" },
        "creditsSettled": { "type": "integer" },
        "creditsRefunded": { "type": "integer" },
        "estimatedUsdCost": { "type": "number" },
        "status": { "type": "string", "enum": ["RESERVED", "SETTLED", "REFUNDED", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "taskId", "operationType", "creditsReserved",
        "creditsSettled", "creditsRefunded", "estimatedUsdCost", "status",
        "createdAt", "updatedAt"
      ]
    },
    "CytonSchedule": {
      "title": "CytonSchedule",
      "description": "Recurring server/background schedule definition supporting closed-browser execution.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "workflowId": { "type": "string" },
        "cronExpression": { "type": "string" },
        "timeZone": { "type": "string" },
        "nextRunEpoch": { "type": "integer" },
        "lastRunEpoch": { "type": "integer" },
        "consecutiveFailures": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessId", "workflowId", "cronExpression", "timeZone",
        "nextRunEpoch", "lastRunEpoch", "consecutiveFailures", "enabled",
        "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile and AI usage tracking."
    },
    "/users/{userId}/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/BusinessWorkspace" },
      "description": "Business workspaces owned by the user."
    },
    "/users/{userId}/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/MarketingCampaign" },
      "description": "Marketing campaigns scoped to user and business."
    },
    "/users/{userId}/content_items/{contentId}": {
      "schema": { "$ref": "#/entities/ContentItem" },
      "description": "Content items, approval workflow states, and scheduled queue items."
    },
    "/users/{userId}/integrations/{integrationId}": {
      "schema": { "$ref": "#/entities/ChannelIntegration" },
      "description": "Channel integration connection and status metadata."
    },
    "/users/{userId}/ai_messages/{messageId}": {
      "schema": { "$ref": "#/entities/AiMessage" },
      "description": "AI Assistant conversation history per business."
    },
    "/users/{userId}/analytics_records/{recordId}": {
      "schema": { "$ref": "#/entities/AnalyticsRecord" },
      "description": "Marketing performance and spend records."
    },
    "/users/{userId}/cyton_settings/{settingId}": {
      "schema": { "$ref": "#/entities/CytonSettings" },
      "description": "Per-business CYTON autonomy policies and emergency kill switch."
    },
    "/users/{userId}/cyton_agents/{agentId}": {
      "schema": { "$ref": "#/entities/CytonAgent" },
      "description": "Specialised CYTON agent registry and tool permissions."
    },
    "/users/{userId}/cyton_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/CytonTask" },
      "description": "Queued and completed autonomous CYTON tasks."
    },
    "/users/{userId}/cyton_workflows/{workflowId}": {
      "schema": { "$ref": "#/entities/CytonWorkflow" },
      "description": "CYTON autonomous workflow definitions."
    },
    "/users/{userId}/cyton_memory/{memoryId}": {
      "schema": { "$ref": "#/entities/CytonMemory" },
      "description": "Tenant-isolated business memory and decision retention records."
    },
    "/users/{userId}/cyton_insights/{insightId}": {
      "schema": { "$ref": "#/entities/CytonInsight" },
      "description": "Proactive monitoring insights and outcome feedback."
    },
    "/users/{userId}/cyton_approvals/{approvalId}": {
      "schema": { "$ref": "#/entities/CytonApproval" },
      "description": "Pending and decided CYTON approval requests."
    },
    "/users/{userId}/cyton_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/CytonActivityLog" },
      "description": "Append-only CYTON execution and security audit logs."
    },
    "/users/{userId}/cyton_usage/{usageId}": {
      "schema": { "$ref": "#/entities/CytonUsage" },
      "description": "Credit reservation, settlement, and refund ledger."
    },
    "/users/{userId}/cyton_schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/CytonSchedule" },
      "description": "Recurring CYTON workflow schedules."
    }
  }
}
