      match /cyton_agents/{agentId} {
        allow get: if isOwner(userId) && isValidId(agentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(agentId) &&
                         incoming().keys().hasAll([
                           'userId', 'businessId', 'role', 'displayName', 'status',
                           'allowedTools', 'tasksCompleted', 'lastRunAtEpoch', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'role', 'displayName', 'status',
                           'allowedTools', 'tasksCompleted', 'lastRunAtEpoch', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCytonAgent(incoming(), userId) &&
                         businessExists(userId, incoming().businessId);
        allow update: if isOwner(userId) && isValidId(agentId) &&
                         isValidCytonAgent(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().businessId == existing().businessId &&
                         incoming().role == existing().role &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'status', 'tasksCompleted', 'lastRunAtEpoch', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(agentId);
      }

      match /cyton_tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) &&
                         incoming().keys().hasAll([
                           'userId', 'businessId', 'workflowId', 'idempotencyKey', 'assignedAgent',
                           'requestedTool', 'title', 'inputSummary', 'priority', 'status',
                           'retryCount', 'maxRetries', 'estimatedCredits', 'actualCredits',
                           'requiresApproval', 'resultSummary', 'errorMessage', 'scheduledRunAtEpoch',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'workflowId', 'idempotencyKey', 'assignedAgent',
                           'requestedTool', 'title', 'inputSummary', 'priority', 'status',
                           'retryCount', 'maxRetries', 'estimatedCredits', 'actualCredits',
                           'requiresApproval', 'resultSummary', 'errorMessage', 'scheduledRunAtEpoch',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidCytonTask(incoming(), userId) &&
                         incoming().status in ['QUEUED', 'AWAITING_APPROVAL'] &&
                         businessExists(userId, incoming().businessId);
        allow update: if isOwner(userId) && isValidId(taskId) &&
                         isValidCytonTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().businessId == existing().businessId &&
                         incoming().idempotencyKey == existing().idempotencyKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'status', 'retryCount', 'actualCredits', 'requiresApproval',
                           'resultSummary', 'errorMessage', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(taskId);
