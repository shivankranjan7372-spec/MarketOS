                         incoming().businessId == existing().businessId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'content', 'retentionDays', 'expiresAtEpoch', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      match /cyton_insights/{insightId} {
        allow get: if isOwner(userId) && isValidId(insightId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(insightId) &&
                         incoming().keys().hasAll([
                           'userId', 'businessId', 'priority', 'category', 'title',
                           'evidenceSummary', 'recommendedAction', 'actualData',
                           'usefulOutcome', 'dismissed', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'priority', 'category', 'title',
                           'evidenceSummary', 'recommendedAction', 'actualData',
                           'usefulOutcome', 'dismissed', 'createdAt', 'updatedAt'
                         ]) &&
