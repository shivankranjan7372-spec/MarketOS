                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'name', 'objective', 'agentsInvolved',
                           'triggerType', 'creditBudgetCap', 'enabled', 'lastRunAtEpoch',
                           'createdAt', 'updatedAt'
                         ]) &&
