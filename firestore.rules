                           'usefulOutcome', 'dismissed', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(insightId);
      }

      match /cyton_approvals/{approvalId} {
        allow get: if isOwner(userId) && isValidId(approvalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(approvalId) &&
                         incoming().keys().hasAll([
                           'userId', 'businessId', 'taskId', 'requestedByAgent', 'actionType',
                           'summary', 'targetCollection', 'targetId', 'estimatedSpend',
                           'currencyCode', 'decision', 'decisionNote', 'decidedAtEpoch',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'taskId', 'requestedByAgent', 'actionType',
                           'summary', 'targetCollection', 'targetId', 'estimatedSpend',
                           'currencyCode', 'decision', 'decisionNote', 'decidedAtEpoch',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidCytonApproval(incoming(), userId) &&
                         incoming().decision == 'PENDING' &&
                         businessExists(userId, incoming().businessId);
        allow update: if isOwner(userId) && isValidId(approvalId) &&
                         isValidCytonApproval(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().businessId == existing().businessId &&
                         incoming().actionType == existing().actionType &&
                         incoming().createdAt == existing().createdAt &&
                         existing().decision == 'PENDING' &&
                         incoming().decision in ['APPROVED', 'REJECTED', 'EXPIRED'] &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'decision', 'decisionNote', 'decidedAtEpoch', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(approvalId);
      }

      match /cyton_activity_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'businessId', 'actor', 'action', 'outcome',
                           'idempotencyKey', 'details', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'actor', 'action', 'outcome',
                           'idempotencyKey', 'details', 'createdAt'
                         ]) &&
                         isValidCytonActivityLog(incoming(), userId) &&
                         businessExists(userId, incoming().businessId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      match /cyton_usage/{usageId} {
        allow get: if isOwner(userId) && isValidId(usageId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(usageId) &&
                         incoming().keys().hasAll([
                           'userId', 'businessId', 'taskId', 'operationType',
                           'creditsReserved', 'creditsSettled', 'creditsRefunded',
                           'estimatedUsdCost', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'taskId', 'operationType',
                           'creditsReserved', 'creditsSettled', 'creditsRefunded',
                           'estimatedUsdCost', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCytonUsage(incoming(), userId) &&
                         incoming().status == 'RESERVED' &&
                         incoming().creditsSettled == 0 &&
                         incoming().creditsRefunded == 0 &&
                         businessExists(userId, incoming().businessId);
        allow update: if isOwner(userId) && isValidId(usageId) &&
                         isValidCytonUsage(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().businessId == existing().businessId &&
                         incoming().taskId == existing().taskId &&
                         incoming().creditsReserved == existing().creditsReserved &&
                         incoming().createdAt == existing().createdAt &&
                         existing().status == 'RESERVED' &&
                         incoming().status in ['SETTLED', 'REFUNDED', 'FAILED'] &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'creditsSettled', 'creditsRefunded', 'estimatedUsdCost', 'status', 'updatedAt'
                         ]);
        allow delete: if false;
      }

      match /cyton_schedules/{scheduleId} {
        allow get: if isOwner(userId) && isValidId(scheduleId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(scheduleId) &&
                         incoming().keys().hasAll([
                           'userId', 'businessId', 'workflowId', 'cronExpression',
                           'timeZone', 'nextRunEpoch', 'lastRunEpoch',
                           'consecutiveFailures', 'enabled', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessId', 'workflowId', 'cronExpression',
                           'timeZone', 'nextRunEpoch', 'lastRunEpoch',
                           'consecutiveFailures', 'enabled', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCytonSchedule(incoming(), userId) &&
                         businessExists(userId, incoming().businessId);
        allow update: if isOwner(userId) && isValidId(scheduleId) &&
                         isValidCytonSchedule(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().businessId == existing().businessId &&
                         incoming().workflowId == existing().workflowId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cronExpression', 'timeZone', 'nextRunEpoch', 'lastRunEpoch',
                           'consecutiveFailures', 'enabled', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(scheduleId);
      }
    }
  }
}
